# Copy this file to .env.local for local development.
# Release deploys create .env on each droplet from the GitHub workflow.
# NEVER commit real values: only this example file goes to Git.

APP_ENV=development
API_URL=http://localhost:8080
LOG_LEVEL=info

# Auth0 config
# The tenant domain Auth0 (ej: dev-xxx.us.auth0.com)
AUTH0_DOMAIN=https://{domain}
# Optional stable application URL. If omitted, Auth0 infers it from the request host.
APP_BASE_URL=http://localhost:3000
# The client ID from your app (Regular Web App)
AUTH0_CLIENT_ID={your-client-id}
# The client secret from auth0
AUTH0_CLIENT_SECRET={your-client-secret}
# A 32-byte secret encoded as 64 hexadecimal characters (openssl rand -hex 32)
AUTH0_SECRET={your-64-character-hex-secret}
# The API identifier configured in Auth0
AUTH0_AUDIENCE={your-api-audience}

# Build-time URL used by Next Image. It must be present when `next build` runs.
PUBLIC_MEDIA_BASE_URL=

# Runtime Google Maps JavaScript API key. Enable Places API and restrict it by web origin.
GOOGLE_MAPS_API_KEY={your-google-maps-api-key}
# Google Maps Map ID with Data-driven styling enabled for administrative boundaries (CABA comunas)
GOOGLE_MAPS_ID={your-google-maps-map-id}
