{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DeliveryExecutionResult",
  "type": "object",
  "required": ["schemaVersion", "status", "snapshotHash", "runKey", "cached", "gate", "summary", "checks", "diagnostics", "evidence"],
  "properties": {
    "schemaVersion": { "type": "integer", "enum": [1] },
    "status": { "type": "string", "enum": ["passed", "failed", "blocked", "needs_input", "review_required", "no_changes"] },
    "snapshotHash": { "type": "string" },
    "runKey": { "type": ["string", "null"] },
    "cached": { "type": "boolean" },
    "gate": {
      "type": "object",
      "required": ["id", "reasonCodes", "postPushChecks"],
      "properties": {
        "id": { "type": "string", "enum": ["NONE", "0", "A", "B", "C", "D"] },
        "reasonCodes": { "type": "array", "items": { "type": "string" } },
        "postPushChecks": { "type": "array", "items": { "type": "string" } }
      }
    },
    "summary": {
      "type": "object",
      "required": ["passed", "failed", "skipped", "durationMs"],
      "properties": {
        "passed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "skipped": { "type": "integer", "minimum": 0 },
        "durationMs": { "type": "integer", "minimum": 0 }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "status", "durationMs"],
        "properties": {
          "id": { "type": "string" },
          "status": { "type": "string", "enum": ["passed", "failed"] },
          "durationMs": { "type": "integer", "minimum": 0 },
          "exitCode": { "type": ["integer", "null"] },
          "summaryLines": { "type": "array", "items": { "type": "string" } },
          "logPath": { "type": "string" }
        }
      }
    },
    "diagnostics": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": ["code", "message", "retryable"],
        "properties": {
          "code": { "type": "string" },
          "message": { "type": "string" },
          "retryable": { "type": "boolean" },
          "checkId": { "type": "string" },
          "file": { "type": "string" },
          "line": { "type": "integer" }
        }
      }
    },
    "evidence": {
      "type": "object",
      "required": ["recordPath"],
      "properties": {
        "recordPath": { "type": ["string", "null"] }
      }
    },
    "failure": {
      "type": "object",
      "required": [
        "signature",
        "checkId",
        "exitCode",
        "message",
        "locations",
        "summaryLines",
        "attemptCount",
        "logPath"
      ],
      "properties": {
        "signature": { "type": "string" },
        "checkId": { "type": "string" },
        "exitCode": { "type": ["integer", "null"] },
        "message": { "type": "string" },
        "locations": { "type": "array", "items": { "type": "string" } },
        "summaryLines": { "type": "array", "items": { "type": "string" }, "maxItems": 6 },
        "attemptCount": { "type": "integer", "minimum": 1 },
        "logPath": { "type": "string" }
      }
    },
    "review": {
      "type": "object",
      "properties": {
        "status": { "type": "string" },
        "snapshotHash": { "type": "string" },
        "reason": { "type": "string" },
        "decisions": { "type": "object" }
      }
    }
  }
}
