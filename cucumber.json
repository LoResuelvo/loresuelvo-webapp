{
  "default": {
    "parallel": 2,
    "paths": ["features/**/*.feature"],
    "require": [
      "features/support/**/*.ts",
      "features/**/*.ts"
    ],
    "requireModule": ["ts-node/register", "tsconfig-paths/register"],
    "format": [
      "summary",
      "html:reports/cucumber-report.html",
      "json:reports/cucumber-report.json"
    ],
    "publishQuiet": true,
    "tags": "not @wip"
  },
  "wip": {
    "paths": ["features/**/*.feature"],
    "require": [
      "features/support/**/*.ts",
      "features/**/*.ts"
    ],
    "requireModule": ["ts-node/register", "tsconfig-paths/register"],
    "format": ["summary"],
    "publishQuiet": true,
    "tags": "@wip"
  }
}
