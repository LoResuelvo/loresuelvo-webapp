{
  "$schema": "./schemas/policy.schema.json",
  "version": 1,
  "policyName": "loresuelvo-delivery-policy",
  "limits": {
    "maxStagedFiles": 500,
    "maxDiffSizeBytes": 2097152,
    "maxSignals": 20,
    "maxDiagnostics": 20,
    "maxCheckLogBytes": 5242880,
    "maxFailureSummaryLines": 6
  },
  "maintainabilityThresholds": {
    "fileLines": 250,
    "functionLines": 60,
    "mainBodyLines": 120,
    "useState": 5,
    "useRef": 5,
    "useCallback": 6,
    "useEffect": 3
  },
  "classification": {
    "rules": [
      {
        "id": "delivery_tooling",
        "category": "delivery_tooling",
        "match": {
          "exact": ["package.json", "package-lock.json", "Makefile", "tsconfig.json", "tsconfig.vitest.json", "vitest.config.ts"],
          "prefixes": ["tools/delivery-mcp/", ".githooks/", ".github/workflows/"],
          "patterns": ["^\\.delivery\\/(?!.*\\.md$)", "^\\.codex\\/(?!.*\\.md$)", "^\\.agents/skills/frontend-maintainability-governance/scripts/"]
        },
        "isGateCTrigger": false,
        "isGate0Trigger": false,
        "productSource": false
      },
      {
        "id": "features_steps_cucumber",
        "category": "features_steps_cucumber",
        "match": { "exact": ["cucumber.json", "tsconfig.cucumber.json"], "prefixes": ["features/"] },
        "isGateCTrigger": false,
        "isGate0Trigger": true,
        "productSource": false
      },
      {
        "id": "routing_layouts",
        "category": "routing_layouts",
        "match": {
          "exact": ["lib/routes.ts"],
          "prefixes": ["lib/routes/"],
          "patterns": ["^app/(?:.*/)?(?:page|layout|route|loading|error|not-found|template|default)\\.[cm]?[jt]sx?$", "^(?:middleware|instrumentation|next\\.config)\\.[cm]?[jt]s$"]
        },
        "isGateCTrigger": true,
        "isGate0Trigger": false,
        "productSource": "auto"
      },
      {
        "id": "server_actions",
        "category": "server_actions",
        "match": {
          "patterns": ["^app/(?:.*/)?actions(?:/.*)?\\.[cm]?[jt]sx?$", "^application/(?:.*/)?actions.*?\\.[cm]?[jt]sx?$"]
        },
        "isGateCTrigger": true,
        "isGate0Trigger": false,
        "productSource": "auto"
      },
      {
        "id": "infrastructure",
        "category": "infrastructure",
        "match": { "prefixes": ["infrastructure/", "app/api/auth/"] },
        "isGateCTrigger": true,
        "isGate0Trigger": false,
        "productSource": "auto"
      },
      {
        "id": "shared_components",
        "category": "shared_components",
        "match": { "patterns": ["^components/(?:ui|shared|common|layouts|modal)(?:/|$)"] },
        "isGateCTrigger": true,
        "isGate0Trigger": false,
        "productSource": "auto"
      },
      {
        "id": "tests",
        "category": "test",
        "match": { "patterns": ["(?:^|/).*\\.(?:test|spec)\\.[cm]?[jt]sx?$"] },
        "isGateCTrigger": false,
        "isGate0Trigger": false,
        "productSource": false
      },
      {
        "id": "isolated_production",
        "category": "isolated_production",
        "match": { "prefixes": ["domain/", "ports/", "application/", "components/", "hooks/", "lib/"] },
        "isGateCTrigger": false,
        "isGate0Trigger": false,
        "productSource": "auto"
      },
      {
        "id": "known_non_functional",
        "category": "non_code_docs_tests_config",
        "match": {
          "exact": [".gitignore", ".dockerignore", ".editorconfig", "AGENTS.md", "CLAUDE.md", "LICENSE"],
          "prefixes": ["docs/", "public/", ".agents/skills/"],
          "extensions": [".md", ".mdx", ".txt", ".png", ".jpg", ".jpeg", ".gif", ".svg", ".webp", ".ico", ".css", ".scss", ".sass", ".less"]
        },
        "isGateCTrigger": false,
        "isGate0Trigger": false,
        "productSource": false
      }
    ],
    "fallback": {
      "category": "unknown_functional",
      "isGateCTrigger": true,
      "isGate0Trigger": false,
      "productSource": "auto"
    }
  },
  "checkCatalog": {
    "steps_compatibility": {
      "kind": "command",
      "label": "Cucumber step compatibility",
      "command": "make",
      "args": ["test-e2e-steps-compatible"],
      "display": "make test-e2e-steps-compatible",
      "timeoutMs": 180000
    },
    "unit": {
      "kind": "command",
      "label": "Unit tests",
      "command": "npm",
      "args": ["run", "test"],
      "display": "npm run test",
      "timeoutMs": 300000
    },
    "delivery_unit": {
      "kind": "command",
      "label": "Delivery runner tests",
      "command": "npm",
      "args": ["run", "delivery:test"],
      "display": "npm run delivery:test",
      "timeoutMs": 180000
    },
    "typecheck_app": {
      "kind": "command",
      "label": "Application typecheck",
      "command": "npx",
      "args": ["--no-install", "tsc", "--noEmit"],
      "display": "npx --no-install tsc --noEmit",
      "timeoutMs": 180000
    },
    "typecheck_cucumber": {
      "kind": "command",
      "label": "Cucumber typecheck",
      "command": "npx",
      "args": ["--no-install", "tsc", "--project", "tsconfig.cucumber.json", "--noEmit"],
      "display": "npx --no-install tsc --project tsconfig.cucumber.json --noEmit",
      "timeoutMs": 180000
    },
    "lint": {
      "kind": "command",
      "label": "Lint",
      "command": "npm",
      "args": ["run", "lint"],
      "display": "npm run lint",
      "timeoutMs": 180000
    },
    "e2e_feature": {
      "kind": "command",
      "label": "Feature E2E",
      "command": "make",
      "args": ["test-e2e-managed", "E2E_FILE={featureFile}"],
      "display": "make test-e2e-managed E2E_FILE={featureFile}",
      "requires": ["featureFile"],
      "timeoutMs": 900000
    },
    "e2e_full": {
      "kind": "command",
      "label": "Full E2E suite",
      "command": "make",
      "args": ["test-e2e-managed"],
      "display": "make test-e2e-managed",
      "timeoutMs": 1200000
    },
    "no_wip_in_scope": {
      "kind": "builtin",
      "label": "No @wip tags in completed scope",
      "handler": "no_wip_in_scope",
      "display": "verify no @wip tags in completed feature scope",
      "requires": ["scopeFeatures"]
    }
  },
  "gates": {
    "NONE": {
      "id": "NONE",
      "description": "No local verification required for documentation, styles, non-functional config, or an empty diff",
      "priority": 0,
      "checkIds": [],
      "postPushChecks": []
    },
    "0": {
      "id": "0",
      "description": "Step definition compatibility without starting the app or browser",
      "priority": 1,
      "checkIds": ["steps_compatibility"],
      "postPushChecks": []
    },
    "A": {
      "id": "A",
      "description": "Isolated domain, helper, or unit-tested production code",
      "priority": 2,
      "checkIds": ["unit", "typecheck_app"],
      "postPushChecks": []
    },
    "B": {
      "id": "B",
      "description": "Low-risk scenario closure against its complete feature",
      "priority": 3,
      "checkIds": ["e2e_feature"],
      "postPushChecks": []
    },
    "C": {
      "id": "C",
      "description": "Shared architecture or high-risk change verification",
      "priority": 4,
      "checkIds": ["lint", "typecheck_app", "typecheck_cucumber", "unit", "e2e_full"],
      "postPushChecks": []
    },
    "D": {
      "id": "D",
      "description": "Batch or User Story closure full regression",
      "priority": 5,
      "checkIds": ["no_wip_in_scope", "lint", "typecheck_app", "typecheck_cucumber", "unit", "e2e_full"],
      "postPushChecks": ["ci_green"]
    }
  }
}
